{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centinela.local/contracts/api/transaction.schema.json",
  "title": "TransactionSubmit",
  "description": "Contrato canónico Centinela — alineado a MASTER_AI_PROMPT y docs/sprint/semana1/contrato-transaccion.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transactionId",
    "accountId",
    "amount",
    "currency",
    "type",
    "location"
  ],
  "properties": {
    "transactionId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 generado por la fintech. Clave de idempotencia y MessageId."
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "clientObservedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Opcional. Solo diagnóstico; no es fuente de reglas de velocidad."
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "description": "Opcional. Si no llega, el servidor genera uno."
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$",
      "description": "Decimal exacto como string. Hasta 4 decimales. No float."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "type": {
      "type": "string",
      "enum": ["PURCHASE", "TRANSFER", "WITHDRAWAL"]
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchantId", "categoryCode"],
      "properties": {
        "merchantId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "categoryCode": { "type": "string", "minLength": 1, "maxLength": 16 },
        "name": { "type": "string", "maxLength": 128 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$",
          "description": "Decimal string, hasta 6 decimales."
        },
        "longitude": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"
        },
        "city": { "type": "string", "maxLength": 64 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
