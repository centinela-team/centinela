# Environment
APP_ENV=local

# Azure
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-centinela-dev
AZURE_LOCATION=eastus

# Observability
# Obtener con: infrastructure/scripts/setup-observability.ps1
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Rate limit POST /v1/transactions
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Data stores
STORAGE_ACCOUNT_NAME=stcentineladev03
STORAGE_CONTAINER_EVIDENCE=case-documents
STORAGE_CONTAINER_TRANSACTIONS=transactions-raw
# Solo desarrollo local (nunca commitear el valor real):
AZURE_STORAGE_CONNECTION_STRING=

# Messaging
SERVICE_BUS_NAMESPACE=sb-centineladev03.servicebus.windows.net
SERVICE_BUS_QUEUE_TRANSACTIONS=transactions
SERVICE_BUS_QUEUE_CASES=cases

# Secrets
KEY_VAULT_NAME=kv-centineladev03

# Documents
MAX_DOCUMENT_BYTES=5242880
DOCUMENT_INTELLIGENCE_ENDPOINT=

# Auth
USE_MANAGED_IDENTITY=true
